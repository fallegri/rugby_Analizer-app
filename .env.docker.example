# =============================================================================
# Rugby Analyzer - Docker Local Environment
# =============================================================================
# Copy this file to .env before running docker compose.
#
#   cp .env.docker.example .env
#   docker compose -f docker-compose.local.yml up --build
# =============================================================================

# Application
APP_NAME=rugby-analyzer
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=local-dev-secret-change-in-production

# AI Provider (configure at least one)
# Options: nvidia, openai, claude, gemini, ollama
AI_PROVIDER=nvidia

# NVIDIA Nemotron
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# OpenAI (alternative)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4

# Anthropic Claude (alternative)
# CLAUDE_API_KEY=your-claude-api-key-here
# CLAUDE_MODEL=claude-3-sonnet-20240229

# Ollama Local (alternative - run ollama separately)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3

# Computer Vision
YOLO_MODEL_PATH=models/yolov8x.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_DEVICE=auto

# Video Processing
UPLOAD_DIR=uploads/
MAX_UPLOAD_SIZE_MB=500
SUPPORTED_FORMATS=mp4,avi,mov,mkv

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
